{
  "name": "finance-management-saas",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": "22.x" },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start --workspace=apps/server",
    "dev": "concurrently \"npm run dev --workspace=apps/server\" \"npm run dev --workspace=apps/client\"",
    "build": "npm run build --workspace=apps/client && rm -rf public && mv apps/client/dist public",
    "build:vercel": "node scripts/build-vercel.js",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.6.3",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1"
  },
  "resolutions": {
    "cloudinary": "^2.9.0"
  },
  "overrides": {
    "cloudinary": "^2.9.0"
  }
}
