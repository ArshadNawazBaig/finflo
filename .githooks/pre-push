#!/bin/sh
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
    printf '%s\n' 'Push blocked: install Gitleaks to scan for secrets.' >&2
    exit 1
fi

cd "$(git rev-parse --show-toplevel)"

while read -r local_ref local_oid remote_ref remote_oid; do
    case "$local_oid" in
        *[!0]*) ;;
        *) continue ;;
    esac

    blocked_paths=$(git ls-tree -r --name-only "$local_oid" | awk '
        /(^|\/)\.env($|\.)/ && !/(^|\/)\.env\.(example|sample|template)$/ { print }
    ')
    if [ -n "$blocked_paths" ]; then
        printf '%s\n' 'Push blocked: environment files are tracked:' "$blocked_paths" >&2
        exit 1
    fi

    # Scan the complete outgoing history so older branches cannot reintroduce secrets.
    if ! gitleaks git . --log-opts="$local_oid" --redact=100 --no-banner \
        --ignore-gitleaks-allow --max-archive-depth=3 --max-decode-depth=3; then
        printf '%s\n' "Push blocked: the secret scan failed for $local_ref." >&2
        exit 1
    fi
done
