# FinFlo - Server Environment Template
# Copy this file to .env and fill in the values below.
# DO NOT COMMIT THE .env FILE TO VERSION CONTROL!

# Server Configuration
PORT=5001
# IMPORTANT: must be "production" in any deployed environment. The error
# handler, HSTS, CSP, CORS regex and rate-limiters all key off this value.
NODE_ENV=production

# Database
MONGO_URI=your_mongodb_uri

# Authentication
# REQUIRED in production. Generate a strong random secret:
#   openssl rand -hex 64
# The server REFUSES to start if this is missing or shorter than 32 chars.
JWT_SECRET=your_jwt_secret

# Stripe Integration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_BASIC=price_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PORTAL_CONFIGURATION_ID=bpc_...

# Frontend URL
CLIENT_URL=http://localhost:5173

# SMTP Configuration (Emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=your_email@gmail.com
FROM_NAME=YourBrandName

# Cloudinary (Media Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Special Permissions
SUPER_ADMIN_EMAIL=admin@yourdomain.com

RESEND_API_KEY=re.......

# PII Encryption (Bank-Grade Security)
# REQUIRED for encrypting customer CNIC, phone, address at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: Once set, do NOT change this key or encrypted data will be unrecoverable!
ENCRYPTION_KEY=your_64_char_hex_string_here
